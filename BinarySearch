#include <stdio.h>
int BinarySearch(int n,int arr[],int key){
    int l=0,r=n-1,mid=0;
    while(l<=r){
        mid = (l+r)/2;
        if(arr[mid]==key){
            return mid;
        }
        else if(arr[mid]<key){
            l= mid+1;
        }
        else
            r = mid-1;
    }
    return -1;
}
int main() {
    int n=0,key=0,Ans=0;
    printf("Enter the length of Array: ");
    scanf("%d",&n);
    int arr[n];
    printf("Enter the array Elements: ");
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    printf("Enter the key to search: ");
    scanf("%d",&key);
    Ans=BinarySearch(n,arr,key);
        if(Ans==-1){
            printf("Element not found..!");
        }
        else{
            printf("Element found at %d Position",Ans);
        }
    return 0;
}
