# include <stdio.h>
//Selection Sort Logic
void SelectionSort(int n,int arr[])
{
    for(int i=0;i<n-1;i++)
    {
        int min = i;
        for(int j=i+1;j<n;j++)
        {
            if(arr[min]>arr[j])
            {
                min =j;
            }
        }
        if(min!=i)
        {
            int temp = arr[min];
            arr[min]=arr[i];
            arr[i]=temp;
        }
    }
}
int main()
{
    //Array Initialization and Accept
   int n=0;
   printf("Enter The size of array: ");
   scanf("%d",&n);
   
   int arr[n];
   printf("Enter array Elements: ");
   for(int i=0;i<n;i++)
   {
       scanf("%d",&arr[i]);
   }
   
   //Selection Sort Calling
   SelectionSort(n,arr);
   printf("Sorted Array: ");
   for(int i=0;i<n;i++)
   {
       printf("%d ",arr[i]);
   }
    return 0;
}
