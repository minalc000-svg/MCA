#include <stdio.h>
//insertion sort logic
void insertionSort(int n, int a[])
{
    int i, j, temp;

    for(i = 1; i < n; i++)
    {
        temp = a[i];

        for(j = i - 1; j >= 0 && a[j] > temp; j--)
        {
            a[j + 1] = a[j];
        }

        a[j + 1] = temp;
    }
}

int main()
{
//array initialization
    int n, i;

    printf("Enter size of array: ");
    scanf("%d", &n);

    int a[n];
    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    insertionSort(n, a);

    printf("Sorted array:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d ", a[i]);
    }

    return 0;
}
